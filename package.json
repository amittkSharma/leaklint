{
  "name": "@amittksharma/leaklint",
  "version": "0.0.1",
  "description": "Find log statements that leak secrets or personal data (PII) in JavaScript and TypeScript. A zero-config CI gate with fix suggestions, baselines for legacy code, and SARIF, JUnit and HTML reports.",
  "type": "module",
  "bin": {
    "leaklint": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "yarn build && node --test \"dist/test/**/*.test.js\"",
    "types": "tsc --noEmit",
    "lint": "biome check .",
    "release": "commit-and-tag-version",
    "release:first": "commit-and-tag-version --first-release",
    "prepublishOnly": "yarn test",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "logging",
    "log-security",
    "pii",
    "gdpr",
    "secrets",
    "secret-detection",
    "sensitive-data",
    "data-leak",
    "data-leak-prevention",
    "static-analysis",
    "sast",
    "devsecops",
    "security",
    "compliance",
    "linter",
    "ci",
    "pino",
    "winston",
    "bunyan",
    "sarif",
    "junit",
    "typescript",
    "javascript",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.0.0",
    "commit-and-tag-version": "^13.2.1"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amittkSharma/leaklint.git"
  },
  "bugs": {
    "url": "https://github.com/amittkSharma/leaklint/issues"
  },
  "homepage": "https://github.com/amittkSharma/leaklint#readme",
  "author": "Amitt K Sharma"
}
