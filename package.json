{
  "name": "leaklint",
  "version": "0.0.1",
  "description": "Static CI gate that finds log statements writing secrets or personal data (PII) in JS/TS. Knows console, stdout/stderr, pino, winston, bunyan.",
  "type": "module",
  "bin": { "leaklint": "dist/src/cli.js" },
  "files": ["dist/src"],
  "scripts": {
    "build": "tsc",
    "test": "yarn build && node --test \"dist/test/**/*.test.js\"",
    "types": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "keywords": ["pii", "logging", "security", "gdpr", "pino", "winston", "sarif", "junit", "static-analysis", "ssn", "secrets"],
  "license": "MIT",
  "dependencies": { "typescript": "^5.6.0" },
  "devDependencies": { "@types/node": "^22.0.0" }
}
